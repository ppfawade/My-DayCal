<script>
  function toggleTask(btn) {
    const checkIcon = btn.querySelector('.material-symbols-outlined');
    const title = btn.closest('.group').querySelector('.task-title');
    const isCompleted = !checkIcon.classList.contains('hidden');
    
    if (isCompleted) {
      checkIcon.classList.add('hidden');
      title.classList.remove('line-through', 'opacity-50');
      btn.classList.remove('bg-tertiary-container/30');
      btn.classList.add('bg-surface-container-highest');
    } else {
      checkIcon.classList.remove('hidden');
      title.classList.add('line-through', 'opacity-50');
      btn.classList.add('bg-tertiary-container/30');
      btn.classList.remove('bg-surface-container-highest');
    }
  }

  function openRapidModal() {
    const modal = document.getElementById('quickModal');
    const input = document.getElementById('quickTaskInput');
    modal.classList.remove('hidden');
    input.focus();
  }

  function closeRapidModal() {
    const modal = document.getElementById('quickModal');
    modal.classList.add('hidden');
  }

  function quickFill(time) {
    const modal = document.getElementById('quickModal');
    const input = document.getElementById('quickTaskInput');
    modal.classList.remove('hidden');
    input.value = time + ' ';
    input.focus();
  }

  function commitQuickTask() {
    const input = document.getElementById('quickTaskInput');
    if (input.value.trim().length > 0) {
      closeRapidModal();
      input.value = '';
    }
  }
</script></main><div class="fixed bottom-6 inset-x-0 z-40 flex justify-center pointer-events-none pb-safe"><button aria-label="Add task or event" class="pointer-events-auto w-14 h-14 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-[0_0_24px_rgba(245,158,11,0.5)] active:scale-95 transition-transform hover:brightness-110 cursor-pointer" onclick="openRapidModal()" type="button"><span class="material-symbols-outlined text-[28px] font-bold">add</span></button></div>

